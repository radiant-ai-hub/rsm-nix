# github: backward-compatible wrapper for `rsm-github` (the setup command was
# renamed to match the rsm-* convention and so it cannot be shadowed by a shell
# alias -- oh-my-zsh's web-search plugin and GitHub Desktop both define a
# browser-opening `github`, and aliases beat PATH commands). Prefer `rsm-github`.
#
# NOTE: this only runs if `github` is NOT aliased in your shell. If typing
# `github` just opens a browser, an alias is shadowing it -- use `rsm-github`.
exec rsm-github "$@"
