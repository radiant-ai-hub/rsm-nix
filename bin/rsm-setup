# rsm-setup: one-shot workspace bootstrap.
#   - creates the workspace (~/rsm-msba) with a generated .envrc + .vscode
#   - creates RSM-owned state directories under $RSMBASE
#   - creates/refreshes the "nix-uv" environment (delegates to rsm-python-sync)
#   - installs/refreshes the "Python (nix-uv)" Jupyter kernel for VS Code
#   - pre-creates course folders listed in the flake's courses.txt
#
# The flake (~/rsm-nix) and the workspace (~/rsm-msba) are separate, so the
# workspace is NOT a git repo and each course folder can be its own. No host
# dotfiles (~/.zshrc, ~/.bashrc) are ever written.

echo "==> RSM-MSBA setup"
echo "    flake     : $RSM_FLAKE"
echo "    workspace : $RSM_WORKSPACE"
echo "    state     : $RSMBASE"

# Make sure the flake is present and current. This makes `rsm-setup` the single
# command for everything: it clones the flake if it is missing (so it works even
# after deleting ~/rsm-nix), and fast-forwards it to the latest otherwise (so
# `rsm-setup` doubles as the update command). All environment content
# (packages, examples, zsh, scripts) then comes from this one place.
# RSM_SKIP_FLAKE_UPDATE=1 uses $RSM_FLAKE EXACTLY as-is: no clone, no git pull,
# no self-update re-exec. CI sets it (with RSM_FLAKE pointed at the checkout) so
# the E2E exercises the branch's own rsm-setup -- otherwise this would clone main
# into ~/rsm-nix and hand off to main's copy, and a PR's rsm-setup changes would
# never actually run. Also handy for an offline or deliberately pinned flake.
if [ -z "${RSM_SKIP_FLAKE_UPDATE:-}" ]; then
  # Make sure the flake is present and current. This makes `rsm-setup` the single
  # command for everything: it clones the flake if it is missing (so it works even
  # after deleting ~/rsm-nix), and fast-forwards it to the latest otherwise (so
  # `rsm-setup` doubles as the update command). All environment content
  # (packages, examples, zsh, scripts) then comes from this one place.
  _head_before="$(git -C "$RSM_FLAKE" rev-parse HEAD 2>/dev/null || echo none)"
  if [ ! -e "$RSM_FLAKE/flake.nix" ]; then
    echo "    flake     : cloning rsm-nix -> $RSM_FLAKE"
    git clone https://github.com/radiant-ai-hub/rsm-nix.git "$RSM_FLAKE"
  elif [ -d "$RSM_FLAKE/.git" ]; then
    if git -C "$RSM_FLAKE" pull --ff-only >/dev/null 2>&1; then
      echo "    flake     : updated $RSM_FLAKE to latest"
    else
      # Fast-forward failed. This clone is meant to be PRISTINE -- every student
      # edit lives in ~/rsm-msba, never here -- so a non-ff almost always means the
      # upstream history was rewritten (a force-push) and this clone has diverged.
      # Left alone, `git pull` keeps failing silently and the student is stranded on
      # an old commit forever (never receiving fixes). Re-sync HARD to the upstream
      # default branch. Guarded so we never nuke a clone that isn't ours or that has
      # uncommitted edits; the discarded commits are still reachable via the backup
      # tag for a while, just in case.
      _origin="$(git -C "$RSM_FLAKE" remote get-url origin 2>/dev/null || true)"
      if printf '%s' "$_origin" | grep -q 'radiant-ai-hub/rsm-nix' &&
         [ -z "$(git -C "$RSM_FLAKE" status --porcelain 2>/dev/null)" ] &&
         git -C "$RSM_FLAKE" fetch --quiet origin 2>/dev/null; then
        _defbranch="$(git -C "$RSM_FLAKE" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
        [ -n "$_defbranch" ] || _defbranch=main
        git -C "$RSM_FLAKE" tag -f rsm-presync-backup HEAD >/dev/null 2>&1 || true
        if git -C "$RSM_FLAKE" reset --hard "origin/$_defbranch" >/dev/null 2>&1; then
          echo "    flake     : re-synced $RSM_FLAKE to origin/$_defbranch (upstream history had diverged)"
        fi
      else
        echo "    flake     : WARNING — could not update $RSM_FLAKE (diverged, or has local changes); leaving it untouched" >&2
      fi
    fi
  fi

  # If the pull above brought new commits, hand off to the freshly-pulled rsm-setup
  # so ONE run applies everything -- including changes to rsm-setup itself (the
  # running copy can't). No-op when nothing changed / already re-run / can't build.
  _head_after="$(git -C "$RSM_FLAKE" rev-parse HEAD 2>/dev/null || echo none)"
  rsm_maybe_reexec "$_head_before" "$_head_after"
fi

mkdir -p "$RSM_WORKSPACE"

# 0a. Generate/refresh the workspace .envrc (loads the flake; cascades into
#     subfolders). Refreshed every run (like .vscode below) so watch_file
#     changes reach existing workspaces; the direnv re-allow that a content
#     change triggers is handled at the end of this script (direnv keys "allow"
#     on the .envrc content hash, so an unchanged rewrite is a no-op).
cat > "$RSM_WORKSPACE/.envrc" <<EOF
# RSM-MSBA workspace — loads the environment from the flake at $RSM_FLAKE.
# Update the environment with:   cd $RSM_FLAKE && git pull
#
# Generated by rsm-setup. This folder is NOT a git repo, so each course folder
# here (mgta403, ...) can be its own git repo without nesting conflicts.
export RSM_FLAKE="$RSM_FLAKE"
export RSM_WORKSPACE="$RSM_WORKSPACE"
# A change to any watched file makes direnv reload (rebuild the dev shell) on the
# next cd, so a git pull in the flake propagates without a manual rebuild;
# bin/rsm-setup is included so its own changes take effect too.
watch_file "$RSM_FLAKE/flake.nix" "$RSM_FLAKE/flake.lock" "$RSM_FLAKE/pyproject.toml" "$RSM_FLAKE/uv.lock" "$RSM_FLAKE/shell/rsm-shell-hook.sh" "$RSM_FLAKE/bin/rsm-env.sh" "$RSM_FLAKE/bin/rsm-setup"
use flake "$RSM_FLAKE"
EOF
echo "    .envrc    : refreshed $RSM_WORKSPACE/.envrc"

# 0b. RSM-owned state directories (needed before the Python sync below).
mkdir -p \
  "$RSMBASE/envs" \
  "$RSMBASE/uv-cache" \
  "$RSMBASE/jupyter" \
  "$RSMBASE/postgres" \
  "$RSMBASE/zsh" \
  "$RSMBASE/logs"

# 1. Python environment (creates the nix-uv venv + installs course-core packages).
rsm-python-sync

# 1b. Workspace VS Code config (.vscode/settings.json + extensions.json), via the
#     shared helper that `rsm-mkdir` also uses to scaffold nested folders -- so the
#     config is generated in one place. ${workspaceFolder} keeps the file identical
#     for every student/OS; running after the sync gives the curated-settings merge
#     the nix-uv python. (VS Code reads workspace settings.json on the remote;
#     keybindings are user-scoped -- there is no per-workspace keybindings file --
#     so they are installed into the User dir on a laptop by step 1e below.)
rsm-vscode-settings "$RSM_WORKSPACE" \
  --interp "\${workspaceFolder}/.rsm-msba/envs/nix-uv/bin/python" \
  --zdotdir "\${workspaceFolder}/.rsm-msba/zsh"
echo "    vscode    : wrote $RSM_WORKSPACE/.vscode/{settings,extensions}.json"

# 1b2. Workspace Claude Code "agentic engineering" harness (.claude/ + CLAUDE.md),
#      via the shared generator that rsm-mkdir also uses for nested folders.
#      Course-agnostic habits + gentle hooks; telemetry self-scopes to rsm-msba-*
#      repos, so the workspace root (not a repo) is never logged.
rsm-claude-settings "$RSM_WORKSPACE"

# 1b3. A SINGLE justfile at the workspace root. `just` searches UP the directory
#      tree, so this one file is found from every subfolder below (no per-folder
#      copy needed), and its recipes run in the folder you invoke `just` from.
#      Refresh the RSM-managed file (new marker or the old RSM signature), but keep
#      a user's own edited justfile untouched.
# (Operate on the lowercase `justfile` only. A capital `Justfile` check is unsafe on
# macOS's case-insensitive filesystem -- it would match this very file and skip the
# refresh forever. The marker/signature test already protects a user's own file.)
_rsm_jf="$RSM_WORKSPACE/justfile"
if [ ! -e "$_rsm_jf" ] || grep -qE '_rsmManaged|Provided by the RSM-MSBA environment' "$_rsm_jf" 2>/dev/null; then
  cp -f "$RSM_FLAKE/claude/justfile" "$_rsm_jf"
  echo "    justfile  : $_rsm_jf (RSM-managed; just finds it from any subfolder)"
else
  echo "    justfile  : kept your own $_rsm_jf (no _rsmManaged marker)"
fi

# 1c. Point VS Code's Remote-SSH machine settings at the nix-uv interpreter, so
#     ANY folder opened on this server -- even a nested one with no .vscode/ of
#     its own -- defaults to the RSM Python instead of a stray /usr/bin/python or
#     a leftover base-uv env. VS Code (Remote-SSH) reads this file on the server.
#     Merge, never clobber: keep any other machine settings the student has set.
#     Harmless if they never connect with Remote-SSH. A workspace .vscode/ (root
#     or `rsm-mkdir`) and any auto-detected ./.venv still override this fallback.
_vscode_machine="$HOME/.vscode-server/data/Machine/settings.json"
if [ -x "$RSM_UV_ENV/bin/python" ]; then
  mkdir -p "$(dirname "$_vscode_machine")"
  "$RSM_UV_ENV/bin/python" - "$_vscode_machine" "$RSM_UV_ENV/bin/python" <<'PY'
import json, os, sys
path, interp = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        data = {}  # unreadable/corrupt -> start clean rather than fail setup
data["python.defaultInterpreterPath"] = interp
data.setdefault("python.terminal.activateEnvironment", False)
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PY
  echo "    vscode    : Remote-SSH default interpreter -> nix-uv (Machine settings)"
fi

# 1d. On a laptop with VS Code installed, also set the LOCAL default interpreter
#     (User settings) so opening a folder locally (not via Remote-SSH) still
#     defaults to nix-uv. Absolute path -> no dependency on VS Code variable
#     resolution. NON-destructive: if settings.json exists but is not plain JSON
#     (e.g. it has // comments), leave it untouched rather than risk clobbering.
#     Skipped on headless servers (no local VS Code User dir).
case "$(uname -s)" in
  Darwin) _vscode_user="$HOME/Library/Application Support/Code/User/settings.json" ;;
  *)      _vscode_user="$HOME/.config/Code/User/settings.json" ;;
esac
if [ -x "$RSM_UV_ENV/bin/python" ] && [ -d "$(dirname "$_vscode_user")" ]; then
  if "$RSM_UV_ENV/bin/python" - "$_vscode_user" "$RSM_UV_ENV/bin/python" <<'PY'
import json, os, sys
path, interp = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        sys.exit(3)  # not plain JSON -> do not touch the student's settings
data["python.defaultInterpreterPath"] = interp
data.setdefault("python.terminal.activateEnvironment", False)
with open(path, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
PY
  then
    echo "    vscode    : local User default interpreter -> nix-uv"
  else
    echo "    note      : left local VS Code User settings.json untouched (unparseable JSON); set python.defaultInterpreterPath to $RSM_UV_ENV/bin/python manually" >&2
  fi
fi

# 1e. VS Code keybindings (User-scoped -- VS Code has NO per-workspace
#     keybindings, so these cannot live in a workspace .vscode/). Merge the
#     curated bindings (vscode/keybindings.json) into the LOCAL User dir when
#     this is a laptop with VS Code. SKIPPED on a headless server: there VS Code
#     runs on the student's laptop over Remote-SSH and uses the laptop's
#     keybindings, so a server-side file would never apply. Detect "laptop" by
#     an existing local Code User dir (never present on a headless server), plus
#     the app itself on macOS so a fresh install gets them before first launch.
case "$(uname -s)" in
  Darwin) _kb_user_dir="$HOME/Library/Application Support/Code/User" ;;
  *)      _kb_user_dir="$HOME/.config/Code/User" ;;
esac
_kb_local=0
[ -d "$_kb_user_dir" ] && _kb_local=1
if [ "$(uname -s)" = "Darwin" ] &&
   { [ -d "/Applications/Visual Studio Code.app" ] || [ -d "$HOME/Applications/Visual Studio Code.app" ]; }; then
  _kb_local=1
fi
if [ "$_kb_local" = "1" ] && command -v rsm-vscode-keybindings >/dev/null 2>&1; then
  rsm-vscode-keybindings "$_kb_user_dir" 2>&1 | sed 's/^/    /' || true
fi

# 2. Jupyter kernelspec so VS Code / Jupyter can find the nix-uv environment.
if [ -x "$RSM_UV_ENV/bin/python" ] && "$RSM_UV_ENV/bin/python" -c "import ipykernel" 2>/dev/null; then
  "$RSM_UV_ENV/bin/python" -m ipykernel install \
    --name nix-uv \
    --display-name "Python (nix-uv)" \
    --prefix "$RSMBASE/jupyter/_prefix" >/dev/null 2>&1 || true
  src="$RSMBASE/jupyter/_prefix/share/jupyter/kernels/nix-uv"
  if [ -d "$src" ]; then
    mkdir -p "$JUPYTER_DATA_DIR/kernels"
    rm -rf "$JUPYTER_DATA_DIR/kernels/nix-uv"
    cp -R "$src" "$JUPYTER_DATA_DIR/kernels/nix-uv"
    rm -rf "$RSMBASE/jupyter/_prefix"
    # Bake native-library search paths into the kernelspec. A Jupyter kernel
    # launched by VS Code never sources the dev-shell hook, and on macOS SIP
    # strips DYLD_* before the kernel starts -- so wheels that dlopen a native
    # lib fail there: libstdc++ for many manylinux wheels on NixOS, and libomp
    # for xgboost on macOS (its wheel links @rpath/libomp.dylib and only rpaths
    # Homebrew, so students would otherwise need `brew install libomp`). Inject
    # the LITERAL paths from this dev-shell env (nativeEnvHook sets
    # LD_LIBRARY_PATH on Linux, DYLD_FALLBACK_LIBRARY_PATH on macOS) so the kernel
    # is self-contained no matter how it is launched.
    "$RSM_UV_ENV/bin/python" - "$JUPYTER_DATA_DIR/kernels/nix-uv/kernel.json" <<'PY'
import json, os, sys
path = sys.argv[1]
with open(path) as f:
    spec = json.load(f)
env = dict(spec.get("env", {}))
for var in ("LD_LIBRARY_PATH", "DYLD_FALLBACK_LIBRARY_PATH"):
    val = os.environ.get(var)
    if val:
        env[var] = val
if env:
    spec["env"] = env
    with open(path, "w") as f:
        json.dump(spec, f, indent=1)
        f.write("\n")
PY
  fi
  echo "    kernel    : Python (nix-uv) -> $JUPYTER_DATA_DIR/kernels/nix-uv"
else
  echo "    kernel    : skipped (ipykernel not available yet)"
fi

# 2b. Native-library preload for the TERMINAL (macOS SIP-proof). The kernel.json
#     above fixes notebooks, but macOS SIP strips DYLD_* before python starts in
#     a terminal, so xgboost still could not find libomp there. Install a
#     sitecustomize on PYTHONPATH (a non-DYLD_* var SIP keeps; wired up in
#     bin/rsm-env.sh) that preloads libomp by absolute path -- so `import xgboost`
#     works in a terminal, in scripts, AND in notebooks, with no `brew install
#     libomp`. See shell/rsm-sitecustomize.py. Baking RSM_OMP_LIBDIR as a literal
#     fallback keeps it working even if the env var is ever missing. On Linux
#     RSM_OMP_LIBDIR is unset (no SIP, no preload needed) and the file no-ops.
if [ -n "${RSM_SITECUSTOMIZE_SRC:-}" ] && [ -f "$RSM_SITECUSTOMIZE_SRC" ]; then
  mkdir -p "$RSMBASE/pythonpath"
  sed "s|@RSM_OMP_LIBDIR@|${RSM_OMP_LIBDIR:-}|g" \
    "$RSM_SITECUSTOMIZE_SRC" > "$RSMBASE/pythonpath/sitecustomize.py"
  echo "    preload   : libomp sitecustomize -> $RSMBASE/pythonpath/sitecustomize.py"
  # macOS: drop the @rpath-id'd libomp copy (built by the flake with install name
  # @rpath/libomp.dylib + ad-hoc signature) NEXT TO the sitecustomize, which
  # preloads it. This is what actually resolves xgboost's @rpath/libomp.dylib in
  # a terminal -- no Homebrew, no DYLD_*. A plain cp keeps the signature (it is
  # embedded in the Mach-O). Linux leaves RSM_OMP_RPATH_LIB unset (no preload).
  if [ -n "${RSM_OMP_RPATH_LIB:-}" ] && [ -f "$RSM_OMP_RPATH_LIB" ]; then
    cp -f "$RSM_OMP_RPATH_LIB" "$RSMBASE/pythonpath/libomp.dylib"
    chmod u+w "$RSMBASE/pythonpath/libomp.dylib"
    echo "    preload   : libomp (@rpath id) -> $RSMBASE/pythonpath/libomp.dylib"
  fi
fi

# 2b. zsh: install oh-my-zsh + powerlevel10k into the workspace ZDOTDIR
#     ($RSMBASE/zsh). The generated .vscode/settings.json points VS Code
#     terminals here, so the rsm-msba environment gets the full RSM shell while
#     your normal login shell stays untouched. Assets come from the flake
#     (RSM_OMZ_SRC), so there is no per-user GitHub cloning.
zdotdir="$RSMBASE/zsh"
if [ -n "${RSM_OMZ_SRC:-}" ] && [ -d "$RSM_OMZ_SRC" ]; then
  mkdir -p "$zdotdir/.cache"
  # SYMLINK the read-only (Nix-store) oh-my-zsh + plugins instead of copying.
  # Copying drags the store's read-only files into the workspace, which both
  # fails mid-copy and makes `rm -rf ~/rsm-msba` impossible. Symlinks keep the
  # workspace fully writable/deletable (rm removes the link, not the store).
  # First clean up any read-only copy left by an older rsm-setup.
  for _link in .oh-my-zsh plugins; do
    if [ -e "$zdotdir/$_link" ] && [ ! -L "$zdotdir/$_link" ]; then
      chmod -R u+w "${zdotdir:?}/$_link" 2>/dev/null || true
      rm -rf "${zdotdir:?}/$_link" 2>/dev/null || true
    fi
    ln -sfn "$RSM_OMZ_SRC/$_link" "$zdotdir/$_link"
  done
  # Writable config, refreshed from the flake each run (cp -f replaces a
  # read-only dest; chmod keeps it writable for the next refresh). Prefer the
  # LIVE flake source ($RSM_FLAKE, git-pulled at the top of this script) over the
  # path baked into this command, so a plain `rsm-setup` applies zshrc/p10k
  # updates without needing a Nix rebuild of the dev shell first.
  _zdt="$RSM_FLAKE/shell/zdotdir"
  [ -d "$_zdt" ] || _zdt="${RSM_ZDOTDIR_TEMPLATE:-}"
  if [ -n "$_zdt" ] && [ -d "$_zdt" ]; then
    cp -f "$_zdt/zshrc" "$zdotdir/.zshrc"
    cp -f "$_zdt/p10k.zsh" "$zdotdir/.p10k.zsh"
    chmod u+w "$zdotdir/.zshrc" "$zdotdir/.p10k.zsh" 2>/dev/null || true
  fi
  echo "    zsh       : oh-my-zsh + powerlevel10k -> $zdotdir (ZDOTDIR)"
fi

# 3. Pre-create course folders from the flake's courses.txt, under the workspace,
#    and set each up as a FIRST-CLASS RSM folder -- exactly like `rsm-mkdir`
#    (which does the per-folder work). So opening a course folder DIRECTLY in VS
#    Code (not just the workspace root) gets the interpreter, the RSM zsh
#    terminal, the curated settings, the recommended extensions and the
#    keybindings -- and a plain `cd` still works via direnv. `source_up` keeps
#    the shared nix-uv Python by default; a local ./.venv the student later
#    creates auto-activates instead. Idempotent + non-destructive: a folder the
#    student has turned into their own repo keeps its own .envrc/.vscode, and
#    folders older runs left plain get upgraded here. Falls back to a bare mkdir
#    if rsm-mkdir isn't available.
courses_file="$RSM_FLAKE/courses.txt"
if [ -f "$courses_file" ]; then
  while IFS= read -r course || [ -n "$course" ]; do
    course="${course%%#*}"
    course="$(printf '%s' "$course" | tr -d '[:space:]')"
    [ -z "$course" ] && continue
    if command -v rsm-mkdir >/dev/null 2>&1; then
      if rsm-mkdir "$RSM_WORKSPACE/$course" >/dev/null 2>&1; then
        echo "    course    : $course/ ready (direnv + .vscode, shared nix-uv)"
      else
        mkdir -p "$RSM_WORKSPACE/$course"
        echo "    course    : $course/ created (full setup skipped; rsm-mkdir failed)" >&2
      fi
    elif [ ! -d "$RSM_WORKSPACE/$course" ]; then
      mkdir -p "$RSM_WORKSPACE/$course"
      echo "    course    : created $RSM_WORKSPACE/$course"
    fi
  done < "$courses_file"
fi

# 4. Refresh the examples in the workspace. We COPY (not symlink) so the folder
#    lives under the workspace's own .envrc — a symlink into $RSM_FLAKE would make
#    `cd examples` resolve into the flake repo and trip its (unallowed) .envrc.
#    We refresh on every run (so new/updated examples like notebooks appear);
#    these are reference/test files, not coursework (which lives in course
#    folders), so replacing them is safe.
if [ -d "$RSM_FLAKE/examples" ]; then
  rm -rf "${RSM_WORKSPACE:?}/examples"
  cp -R "$RSM_FLAKE/examples" "$RSM_WORKSPACE/examples"
  echo "    examples  : refreshed $RSM_WORKSPACE/examples"
fi

# 4b. Seed the flake's data/ folder into the workspace. Unlike examples/ (which
#     we refresh/overwrite every run), students may drop their OWN files in
#     data/, so we only ADD what's missing and NEVER overwrite existing files
#     (rsm_seed_dir uses `cp -n`). This gives every new workspace the starter
#     datasets and picks up newly-shipped ones on later runs.
if [ -d "$RSM_FLAKE/data" ]; then
  rsm_seed_dir "$RSM_FLAKE/data" "$RSM_WORKSPACE/data"
  echo "    data      : seeded $RSM_WORKSPACE/data (kept any files you added)"
fi

# 5. README: a live shortcut to the flake's README, so the workspace always
#    shows the current usage/testing docs (updated whenever the flake is pulled).
#    A symlink (not a copy) keeps it in sync; it is a file, so there is no
#    `cd`-into-the-flake problem like the examples folder had.
if [ -f "$RSM_FLAKE/README.md" ]; then
  ln -sfn "$RSM_FLAKE/README.md" "$RSM_WORKSPACE/README.md"
  echo "    readme    : $RSM_WORKSPACE/README.md -> flake README"
fi

# On WSL, Windows PATH interop can put a Windows node/npm/claude (under /mnt/c,
# e.g. an nvm4w install) ahead of the WSL-native ones. Those are Windows .exe
# shims that can't run under Linux, and a leaked `claude` here would make us
# think Claude Code is already installed and SKIP installing the real Linux one
# — leaving the student with a `claude` that only fails. Treat a command as
# present only when it resolves to a native (non-/mnt) path.
rsm_have_native() {
  local p
  p="$(command -v "$1" 2>/dev/null)" || return 1
  case "$p" in /mnt/*) return 1 ;; esac
  return 0
}

# 6. Claude Code: install into the user-writable npm prefix (NPM_CONFIG_PREFIX,
#    set in rsm-env.sh) so students and Claude can upgrade it themselves. It is
#    intentionally NOT pinned by the flake — it updates very frequently and
#    self-updates — while Node IS pinned. Install if missing; `rsm-update` (which
#    sets RSM_CLAUDE_LATEST) forces it to the latest. Non-fatal and time-bounded
#    so a slow/absent network never blocks setup.
if rsm_have_native npm; then
  mkdir -p "$NPM_CONFIG_PREFIX"
  if ! rsm_have_native claude; then
    echo "    claude    : installing @anthropic-ai/claude-code (npm global)"
    if timeout 180 npm install -g @anthropic-ai/claude-code >/dev/null 2>&1; then
      echo "    claude    : $(claude --version 2>/dev/null || echo installed)"
    else
      echo "    claude    : skipped (offline or npm error; run 'rsm-update' later)"
    fi
  elif [ -n "${RSM_CLAUDE_LATEST:-}" ]; then
    echo "    claude    : updating @anthropic-ai/claude-code to latest"
    if timeout 180 npm install -g @anthropic-ai/claude-code@latest >/dev/null 2>&1; then
      echo "    claude    : $(claude --version 2>/dev/null || echo updated)"
    else
      echo "    claude    : update skipped (offline or npm error)"
    fi
  else
    echo "    claude    : $(claude --version 2>/dev/null || echo present)  (run 'rsm-update' to force latest)"
  fi
fi

# 6b. Install the RSM Claude Code skills user-level (~/.claude/skills), so they
#     are available in the workspace AND in folders set up with `rsm-mkdir`
#     anywhere. Assets come from the flake (RSM_SKILLS_SRC); refreshed each run,
#     and only the rsm-* skills are touched (a student's own skills are left alone).
if [ -n "${RSM_SKILLS_SRC:-}" ] && [ -d "$RSM_SKILLS_SRC" ]; then
  skills_dest="$HOME/.claude/skills"
  mkdir -p "$skills_dest"
  for _skill in "$RSM_SKILLS_SRC"/*/; do
    [ -d "$_skill" ] || continue
    _sname="$(basename "$_skill")"
    chmod -R u+w "${skills_dest:?}/$_sname" 2>/dev/null || true
    rm -rf "${skills_dest:?}/$_sname"
    cp -R "$_skill" "$skills_dest/$_sname"
    chmod -R u+w "$skills_dest/$_sname" 2>/dev/null || true
    echo "    skill     : $_sname -> $skills_dest/$_sname"
  done
fi

# 6b2. Install the RSM slash commands user-level (~/.claude/commands), so /review,
#      /explain, /run-tests, /add-function work in EVERY folder and subfolder.
#      Project-scoped commands do NOT reach up from a subfolder to the workspace,
#      so user-level is the reliable place. Refreshed each run; a student's own
#      differently-named commands are left untouched.
_cmd_src="$RSM_FLAKE/claude/commands"
if [ -d "$_cmd_src" ]; then
  cmd_dest="$HOME/.claude/commands"
  mkdir -p "$cmd_dest"
  for _cmd in "$_cmd_src"/*.md; do
    [ -e "$_cmd" ] || continue
    cp -f "$_cmd" "$cmd_dest/"
  done
  echo "    commands  : /review /explain /run-tests /add-function -> $cmd_dest"
fi

# 6c. VS Code extensions into the connected/served remote. rsm-vscode-ext finds
#     the right CLI itself: the remote `code` when run in a VS Code integrated
#     terminal (a live install), or -- when run from a PLAIN server/WSL shell --
#     the bundled headless `code-server` under ~/.vscode-server, which installs
#     into ~/.vscode-server/extensions with no running window. So a student on
#     the server gets the curated extensions whether or not they run rsm-setup
#     inside VS Code (they must have connected with VS Code at least once, which
#     creates ~/.vscode-server). Non-fatal; fast on re-runs (installs only what's
#     missing). Its stderr is shown (not swallowed) so a "connect once" hint is
#     visible when there is no ~/.vscode-server yet.
if command -v rsm-vscode-ext >/dev/null 2>&1; then
  echo "    vscode    : syncing extensions into the VS Code remote..."
  rsm-vscode-ext 2>&1 | sed 's/^/    vscode    : /' || true
fi

# 7. Approve the generated workspace .envrc so entering ~/rsm-msba "just works"
#    (no "direnv: .envrc is blocked" on first cd). rsm-setup wrote this .envrc
#    itself, so auto-allowing our own generated file is safe.
if command -v direnv >/dev/null 2>&1; then
  if direnv allow "$RSM_WORKSPACE" 2>/dev/null; then
    echo "    direnv    : allowed $RSM_WORKSPACE"
  fi
fi

echo "==> Setup complete."
# Show the version (the flake's git commit) so it is easy to confirm that every
# student/TA/faculty member is on the same environment. Compare 'rsm-version'.
if command -v rsm-version >/dev/null 2>&1; then
  rsm-version | sed 's/^/    /'
fi
echo "    Open $RSM_WORKSPACE in VS Code. Try: rsm-pg-start, then python or quarto."
