# rsm-mkdir [--venv] PATH [PATH ...]: make one or more folders first-class RSM
# folders -- open them directly in VS Code (or a terminal) and get the full Nix
# toolchain + the right Python. Like `mkdir`, PATH is relative to the CURRENT
# directory, so it works for course folders inside ~/rsm-msba AND for projects
# anywhere else:
#
#   rsm-mkdir mgta455            ./mgta455 (nested under ~/rsm-msba: source_up)
#   rsm-mkdir a b c             several at once
#   rsm-mkdir .                the CURRENT folder
#   rsm-mkdir ../thesis        a standalone project outside the workspace
#   rsm-mkdir ~/projects/foo   anywhere (absolute / ~ paths ok)
#   rsm-mkdir --venv analysis  give it its OWN reproducible venv (pyproject+uv)
#
# Each PATH gets .envrc + .vscode + `direnv allow`; an existing repo's own
# .envrc/.vscode is kept. A folder inside ~/rsm-msba loads the workspace env via
# `source_up`; a standalone folder loads the flake directly with `use flake`.
# `--venv` gives the folder its OWN reproducible venv (pyproject.toml + uv.lock,
# grown with `uv add`) -- the alternative to a conda env.

_use_venv=0
_paths=()
for _arg in "$@"; do
  case "$_arg" in
    --venv) _use_venv=1 ;;
    -h|--help)
      echo "usage: rsm-mkdir [--venv] PATH [PATH ...]"
      echo "  PATH   folder(s) to set up; relative to the current dir, or absolute / ~"
      echo "  --venv also create a local ./.venv (pyproject + uv) you own"
      exit 0 ;;
    -*) echo "rsm-mkdir: unknown argument: $_arg" >&2; exit 2 ;;
    *) _paths+=("$_arg") ;;
  esac
done

if [ "${#_paths[@]}" -eq 0 ]; then
  echo "usage: rsm-mkdir [--venv] PATH [PATH ...]" >&2
  echo "  e.g. rsm-mkdir mgta455  |  rsm-mkdir .  |  rsm-mkdir --venv analysis" >&2
  exit 1
fi

# Set up ONE folder as a first-class RSM project. Returns (not exits) so a later
# PATH is still processed if this one is a no-op.
_rsm_setup_folder() {
  local _target="$1"
  local _here _inside _interp _name _ig _kept_envrc="" _kept_vscode=""

  # Resolve the target folder. Expand a leading ~ even if quoted.
  if [ "${_target#\~}" != "$_target" ]; then
    _target="$HOME${_target#\~}"
  fi
  mkdir -p "$_target"
  _here="$(cd "$_target" && pwd)"

  # Is this inside the ~/rsm-msba workspace tree (so direnv's source_up finds the
  # workspace .envrc), or a standalone folder elsewhere?
  case "$_here/" in
    "$RSM_WORKSPACE"/*) _inside=1 ;;
    *) _inside=0 ;;
  esac
  if [ "$_here" = "$RSM_WORKSPACE" ]; then
    echo "rsm-mkdir: the workspace root is already set up by rsm-setup; nothing to do." >&2
    return 0
  fi

  # --- .envrc: load the RSM environment (+ a local .venv if present) --------
  # Don't clobber a repo's OWN .envrc, but DO refresh an rsm-generated one (marked
  # "rsm-msba (managed)") so fixes land on re-run.
  if [ -e "$_here/.envrc" ] && ! grep -qE "rsm-msba \(managed\)|Load the RSM environment|Standalone RSM project" "$_here/.envrc" 2>/dev/null; then
    _kept_envrc=1
  else
    # Loader: nested folders inherit the workspace env via source_up; a standalone
    # folder loads the flake directly with use flake.
    if [ "$_inside" -eq 1 ]; then
      cat > "$_here/.envrc" <<'EOF'
# rsm-msba (managed) -- loads the RSM environment (Nix tools + rsm-* commands +
# the shared nix-uv Python) from the parent ~/rsm-msba workspace. Delete this
# file if you want plain direnv here.
source_up
EOF
    else
      cat > "$_here/.envrc" <<'EOF'
# rsm-msba (managed) -- standalone RSM project: load the flake's tools (Nix +
# rsm-* commands + the shared nix-uv Python) directly. Delete this file if you
# want plain direnv here.
export RSM_FLAKE="${RSM_FLAKE:-$HOME/rsm-nix}"
use flake "$RSM_FLAKE"
EOF
    fi
    # A local ./.venv (from `rsm-mkdir --venv` or a manual `uv venv`) automatically
    # takes over from the shared nix-uv env -- no `source .venv/bin/activate` / `sp`
    # needed. watch_file so creating or removing it reloads direnv.
    cat >> "$_here/.envrc" <<'EOF'

# Where `uv sync`/`uv add` may write. Set UNCONDITIONALLY -- and deliberately so.
# It must be pinned here even when no .venv exists yet, because that is exactly
# the moment the old setup was dangerous: with nothing pinned, uv fell back to
# the SHARED nix-uv env and a first `uv sync` pruned it to this project's deps,
# breaking Python for every other folder. Pinned, the first `uv sync` CREATES
# ./.venv instead. This does not activate anything on its own.
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"

# Activation is separate, and stays conditional: until ./.venv exists the shared
# nix-uv env (from the workspace .envrc) remains the active interpreter, so the
# full course-core Python still works in a folder that has no venv of its own.
watch_file .venv/bin/activate
if [ -f "$PWD/.venv/bin/activate" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  # Prompt label. powerlevel10k shows VIRTUAL_ENV_PROMPT verbatim when it differs
  # from the venv's own directory name, so this string IS what appears in the
  # prompt. It lives in the RIGHT prompt, which p10k drops WHOLESALE when the
  # line does not fit -- so an over-long label does not wrap or truncate, it
  # makes the venv indicator vanish entirely and the shell look unconfigured.
  # Course repos are named rsm-<course>-<topic>-rsm-<studentid>, most of which is
  # boilerplate, so drop the leading "rsm-" and the trailing "-rsm-<id>" (only
  # when the name actually started with "rsm-", so a personal repo like
  # "my-rsm-tools" is left alone), then hard-cap what is left.
  _rsm_label="${PWD##*/}"
  _rsm_short="${_rsm_label#rsm-}"
  if [ "$_rsm_short" != "$_rsm_label" ]; then
    _rsm_short="${_rsm_short%-rsm-*}"
  fi
  if [ "${#_rsm_short}" -gt 20 ]; then
    _rsm_short="${_rsm_short:0:19}…"
  fi
  # VIRTUAL_ENV_PROMPT is the static label (bash, non-p10k shells). RSM_VENV_LABEL
  # is the same string kept intact for the zsh prompt hook, which truncates it to
  # the terminal width per prompt -- it must read the FULL label, never the
  # already-truncated one, or it would shrink a little more on every redraw.
  export VIRTUAL_ENV_PROMPT="($_rsm_short) "
  export RSM_VENV_LABEL="$_rsm_short"
  unset _rsm_label _rsm_short
  export QUARTO_PYTHON="$PWD/.venv/bin/python"
  PATH_add "$PWD/.venv/bin"
  watch_file pyproject.toml uv.lock
fi
EOF
  fi

  if [ "$_use_venv" -eq 1 ]; then
    # A project-local venv (reproducible: pyproject.toml + uv.lock; grow it with
    # `uv add <pkg>`, verify with `rsm-project-check`). The .envrc above ALREADY
    # auto-activates ./.venv, so here we just create the venv + a starter
    # pyproject. \$ keeps ${workspaceFolder} literal for VS Code.
    _interp="\${workspaceFolder}/.venv/bin/python"

    # Starter pyproject.toml (minimal + reproducible). `package = false` makes uv
    # treat this as a plain dependency environment (no build backend needed).
    if [ ! -e "$_here/pyproject.toml" ]; then
      _name="$(basename "$_here")"
      _name="$(printf '%s' "$_name" | tr -c '[:alnum:]._-' '-')"
      while [ "${_name#-}" != "$_name" ]; do _name="${_name#-}"; done
      while [ "${_name%-}" != "$_name" ]; do _name="${_name%-}"; done
      [ -z "$_name" ] && _name="project"
      cat > "$_here/pyproject.toml" <<EOF2
[project]
name = "$_name"
version = "0.1.0"
requires-python = ">=3.13"
dependencies = [
  "ipykernel>=6", # enables the VS Code / Jupyter kernel picker
]

[tool.uv]
package = false # a plain dependency environment, not an installable package
EOF2
    fi

    # Create + populate the venv up front so VS Code sees a valid interpreter now.
    ( cd "$_here" \
      && export UV_PROJECT_ENVIRONMENT="$_here/.venv" \
      && { [ -d .venv ] || uv venv .venv >/dev/null 2>&1; } \
      && uv sync --quiet 2>/dev/null ) || true
  else
    # Absolute path to the shared nix-uv interpreter. VS Code does NOT expand
    # ${userHome} in python.defaultInterpreterPath / terminal env, so a resolved
    # path is required for a nested folder (a repo elsewhere still points at the
    # workspace's shared env, which is what `use flake` provides).
    _interp="$RSM_UV_ENV/bin/python"
  fi

  # Keep build/env artifacts out of git. Append any missing entries rather than
  # only creating the file, so a repo cloned from GitHub (which already has its
  # own .gitignore) still never commits the direnv cache / a local venv.
  touch "$_here/.gitignore"
  for _ig in '.venv/' '.direnv/' '__pycache__/' '*.pyc'; do
    grep -qxF "$_ig" "$_here/.gitignore" 2>/dev/null || printf '%s\n' "$_ig" >> "$_here/.gitignore"
  done

  # VS Code config (interpreter + RSM terminal shell + curated settings +
  # keybindings), via the shared generator that rsm-setup also uses. Absolute
  # paths (not ${userHome}, which VS Code does NOT expand here) so the nix-uv
  # interpreter + ZDOTDIR resolve no matter how deep this folder is nested.
  #
  # Don't clobber a repo's OWN VS Code settings -- but DO refresh an RSM-generated
  # one (so fixes land on re-run). Ours always references ".rsm-msba"; a foreign
  # settings.json won't.
  if [ -e "$_here/.vscode/settings.json" ] && ! grep -q "\.rsm-msba" "$_here/.vscode/settings.json" 2>/dev/null; then
    _kept_vscode=1
  else
    rsm-vscode-settings "$_here" \
      --interp "$_interp" \
      --zdotdir "$RSMBASE/zsh"
  fi

  # Claude Code "agentic engineering" harness (.claude/ + CLAUDE.md + justfile),
  # via the shared generator rsm-setup also uses. Its own keep-foreign guards
  # protect a repo's own CLAUDE.md / justfile / settings.json.
  rsm-claude-settings "$_here"

  if command -v direnv >/dev/null 2>&1; then
    direnv allow "$_here" || true
  fi

  echo "rsm-mkdir: '$_here' is ready to open directly in VS Code or a terminal."
  if [ -n "$_kept_envrc" ] || [ -n "$_kept_vscode" ]; then
    [ -n "$_kept_envrc" ]  && echo "  kept   : the repo's existing .envrc (unchanged)."
    [ -n "$_kept_vscode" ] && echo "  kept   : the repo's existing .vscode/settings.json (unchanged)."
    echo "           (to use the RSM setup instead, delete that file and re-run.)"
  fi
  if [ -z "$_kept_envrc" ]; then
    if [ "$_use_venv" -eq 1 ]; then
      echo "  Python : a local ./.venv you own — add packages with 'uv add <pkg>', check with 'rsm-project-check'."
    else
      echo "  Python : the shared nix-uv environment."
    fi
    echo "  Tools  : uv, quarto, psql, git, gh and the rsm-* commands are on PATH via direnv."
  fi
}

for _p in "${_paths[@]}"; do
  _rsm_setup_folder "$_p"
done
