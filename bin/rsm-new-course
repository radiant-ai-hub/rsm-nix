# rsm-new-course NAME [NAME ...]: create one or more course folders in the
# workspace ($RSM_WORKSPACE, e.g. ~/rsm-msba). Each folder is set up as a
# first-class RSM project -- its own .envrc (source_up) + .vscode/settings.json
# pointing Python at the shared nix-uv interpreter -- so opening it in VS Code
# or a terminal uses the RSM environment via direnv, NOT the server's base-uv.
# Each can be its own git repo (the workspace itself is not a git repo).

if [ "$#" -eq 0 ]; then
  echo "usage: rsm-new-course NAME [NAME ...]" >&2
  echo "  e.g. rsm-new-course mgta455 mgta495" >&2
  exit 1
fi

for course in "$@"; do
  course="$(printf '%s' "$course" | tr -d '[:space:]')"
  [ -z "$course" ] && continue
  # Delegate the setup to rsm-new-project: it creates the folder and writes
  # .envrc (source_up) + .vscode + runs `direnv allow` -- exactly what makes VS
  # Code and the terminal use the shared nix-uv Python instead of falling back
  # to base-uv. Idempotent: safe to re-run on an existing folder.
  rsm-new-project "$RSM_WORKSPACE/$course"
done
