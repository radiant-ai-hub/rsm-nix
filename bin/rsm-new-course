# rsm-new-course NAME [NAME ...]: create one or more course/project folders in
# the workspace ($RSM_WORKSPACE, e.g. ~/rsm-msba). Each can become its own git
# repo (the workspace itself is not a git repo).

if [ "$#" -eq 0 ]; then
  echo "usage: rsm-new-course NAME [NAME ...]" >&2
  echo "  e.g. rsm-new-course mgta455 mgta495" >&2
  exit 1
fi

for course in "$@"; do
  course="$(printf '%s' "$course" | tr -d '[:space:]')"
  [ -z "$course" ] && continue
  mkdir -p "$RSM_WORKSPACE/$course"
  echo "created $RSM_WORKSPACE/$course"
done
