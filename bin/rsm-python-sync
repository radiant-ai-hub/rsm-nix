# rsm-python-sync: create/refresh the "nix-uv" environment from the flake's
# committed lockfile. Idempotent. Safe to run repeatedly.
#
# pyproject.toml + uv.lock live in the flake repo ($RSM_FLAKE); the environment
# is built into the workspace state ($RSM_UV_ENV).

if [ ! -f "$RSM_FLAKE/pyproject.toml" ] || [ ! -f "$RSM_FLAKE/uv.lock" ]; then
  echo "rsm-python-sync: pyproject.toml/uv.lock not found in $RSM_FLAKE" >&2
  echo "  Is the flake cloned there? (git clone … ~/rsm-nix)" >&2
  exit 1
fi

# A uv cache OUTSIDE your home — a shared cache on a multi-user server, e.g.
# /srv/uv-cache owned by a shared group — needs two things handled:
#   1. New files must be group-writable so other users can update the same cache
#      (relax umask to 002; the cache dir is already setgid + group-owned). A
#      per-user cache under $HOME keeps the default umask (home dirs are 0700, so
#      this never widens access to your own files).
#   2. THIS user may not be able to write it at all — most often because they are
#      not in the cache's group. Do NOT fail the whole setup: fall back to a
#      per-user cache so `uv sync` always has a writable location. (You then just
#      don't share the server-wide cache; ask an admin to add you to its group to
#      opt back in.)
case "${UV_CACHE_DIR:-}" in
  "$HOME"/* | "") : ;;
  *)
    umask 002
    if ! mkdir -p "$UV_CACHE_DIR" 2>/dev/null || ! ( : >"$UV_CACHE_DIR/.rsm-write-test" ) 2>/dev/null; then
      echo "rsm-python-sync: shared uv cache '$UV_CACHE_DIR' is not writable by $(id -un);" >&2
      echo "  using a per-user cache at '$RSMBASE/uv-cache' instead (setup continues)." >&2
      echo "  To share the server-wide cache, ask an admin to add you to its group." >&2
      UV_CACHE_DIR="$RSMBASE/uv-cache"; export UV_CACHE_DIR
    else
      rm -f "$UV_CACHE_DIR/.rsm-write-test" 2>/dev/null
    fi
    ;;
esac

mkdir -p "$RSMBASE/envs" "$UV_CACHE_DIR"

# Prefer the Nix-provided interpreter so native libraries stay consistent.
py="$(command -v python3.13 || command -v python3 || true)"
if [ -z "$py" ]; then
  echo "rsm-python-sync: no python3.13/python3 on PATH (are you in 'nix develop'?)" >&2
  exit 1
fi

if [ ! -x "$RSM_UV_ENV/bin/python" ]; then
  echo "Creating the nix-uv environment at $RSM_UV_ENV"
  uv venv --prompt nix-uv --python "$py" "$RSM_UV_ENV"
fi

echo "Syncing nix-uv from uv.lock (this can take a few minutes the first time)..."
( cd "$RSM_FLAKE" && UV_PROJECT_ENVIRONMENT="$RSM_UV_ENV" uv sync --frozen --python "$RSM_UV_ENV/bin/python" )

echo "rsm-python-sync: nix-uv environment ready at $RSM_UV_ENV"
