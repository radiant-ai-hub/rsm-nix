# rsm-msba: alias for `rsm-setup`. As of now rsm-setup clones the flake if it is
# missing, fast-forwards it if present, and (re)builds the workspace — so the two
# commands are equivalent. Kept for discoverability and the "reset" mental model:
#
#   rm -rf ~/rsm-msba ~/rsm-nix && rsm-msba    # full reset from nothing
#   rsm-msba                                   # update + rebuild

exec rsm-setup
