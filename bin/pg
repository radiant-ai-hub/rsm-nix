# pg: PostgreSQL status + a menu of the rsm-pg-* actions. Each menu entry also
# shows the command you can run directly. (PG* come from bin/rsm-env.sh.)

_pg_status() {
  echo "PostgreSQL (workspace-local)"
  echo "  data     : $PGDATA"
  echo "  socket   : $PGHOST"
  echo "  port     : $PGPORT"
  echo "  database : $PGDATABASE    user: $PGUSER"
  if pg_ctl -D "$PGDATA" status >/dev/null 2>&1; then
    echo "  status   : ● RUNNING"
  elif [ ! -d "$PGDATA/base" ]; then
    echo "  status   : ○ not initialized yet"
  else
    echo "  status   : ○ stopped"
  fi
}

_pg_menu() {
  echo
  echo "Actions — enter a number, or run the command directly:"
  printf '  %-3s %-26s %s\n' "1)" "start the server" "rsm-pg-start"
  printf '  %-3s %-26s %s\n' "2)" "stop the server" "rsm-pg-stop"
  printf '  %-3s %-26s %s\n' "3)" "detailed status" "rsm-pg-status"
  printf '  %-3s %-26s %s\n' "4)" "open a psql shell" "rsm-pg-psql"
  printf '  %-3s %-26s %s\n' "5)" "launch pgweb (web UI)" "rsm-pgweb"
  printf '  %-3s %-26s %s\n' "6)" "(re)initialize the data dir" "rsm-pg-init"
  printf '  %-3s %-26s %s\n' "p)" "show recent server log" "tail \$RSMBASE/postgres/postgres.log"
  printf '  %-3s %s\n' "r)" "refresh this overview"
  printf '  %-3s %s\n' "q)" "quit"
}

_pg_status

# No terminal attached (piped / non-interactive): print status + the list, done.
if [ ! -t 0 ] || [ ! -t 1 ]; then
  _pg_menu
  exit 0
fi

# Interactive menu.
while true; do
  _pg_menu
  printf 'pg> '
  read -r ans || break
  echo
  case "$ans" in
    1) rsm-pg-start ;;
    2) rsm-pg-stop ;;
    3) rsm-pg-status ;;
    4) rsm-pg-psql ;;
    5) rsm-pgweb ;;
    6) rsm-pg-init ;;
    p | P) tail -n 30 "$RSMBASE/postgres/postgres.log" 2>/dev/null || echo "  (no log yet)" ;;
    r | R) _pg_status ;;
    q | Q | "") break ;;
    *) echo "  ? unknown option: $ans" ;;
  esac
done
