# Common commands for this project. Run `just` to list them.
# (Provided by the RSM-MSBA environment as a simple, editable starting point.)

# Show the available commands
default:
    @just --list

# Run the test suite
test:
    uv run pytest

# Run tests + lint (the "is this good enough to commit?" check)
check:
    uv run pytest
    uvx ruff check .

# Show what you've changed since the last commit (review before you commit)
review:
    git --no-pager diff HEAD

# Checkpoint your work with a commit message, e.g. `just save "add clv function"`
save msg:
    git add -A
    git commit -m "{{msg}}"

# Verify AI-written work: run the tests, then show the diff for you to read
verify:
    uv run pytest
    @echo "--- review the diff below yourself ---"
    git --no-pager diff HEAD
