# This .envrc is for working ON the flake itself (developing/testing). For the
# student workspace, rsm-setup generates a separate ~/rsm-msba/.envrc that loads
# this flake. Here flake == workspace == this repo, with state kept locally
# (under ./.rsm-msba, gitignored).
#
# Requires direnv + nix-direnv.
_rsm_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$PWD}")" && pwd)"
export RSM_FLAKE="$_rsm_dir"
export RSM_WORKSPACE="$_rsm_dir"

watch_file flake.nix flake.lock pyproject.toml uv.lock courses.txt \
  shell/rsm-shell-hook.sh bin/rsm-env.sh

use flake
