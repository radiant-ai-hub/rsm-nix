# direnv configuration for the RSM-MSBA workspace.
#
# Requires direnv + nix-direnv (see docs/). With those installed, the flake's
# default devShell is loaded automatically here and in every subfolder
# (mgta403/, mgta464/, your projects, ...) so VS Code terminals "just work".

# Pin the workspace root to the directory holding this .envrc, so the shared
# state (~/rsm-msba/.rsm-msba), Python env, and Postgres are the same whether
# direnv activates here or in a nested course folder.
export RSM_WORKSPACE="$(cd "$(dirname "${BASH_SOURCE[0]:-$PWD}")" && pwd)"

# Reload automatically when the environment definition or dependencies change.
watch_file flake.nix flake.lock pyproject.toml uv.lock courses.txt \
  shell/rsm-shell-hook.sh bin/rsm-env.sh

use flake
