# RSM-MSBA environment .zshrc — the full oh-my-zsh + powerlevel10k shell for the
# rsm-msba environment. Loaded two ways: at startup when ZDOTDIR points here (VS
# Code terminals), and mid-session by the system zsh chpwd hook when you cd into
# ~/rsm-msba (kitty and other terminals). Installed/refreshed by `rsm-setup`;
# edit the source in the flake (shell/zdotdir/zshrc), not this copy.

# Guard against double-sourcing (the chpwd hook plus a ZDOTDIR startup read can
# both fire). p10k instant prompt is disabled in .p10k.zsh, so there is no
# instant-prompt cache to source here and mid-session loading stays clean.
[[ -n ${_RSM_ZSHRC_DONE:-} ]] && return 0
typeset -g _RSM_ZSHRC_DONE=1

export ZSH="${ZDOTDIR}/.oh-my-zsh"
export ZSH_CACHE_DIR="${ZDOTDIR}/.cache"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump"
ZSH_DISABLE_COMPFIX="true"
DISABLE_AUTO_UPDATE="true"          # oh-my-zsh is provided by Nix; don't self-update

ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)                        # git via oh-my-zsh's own plugin format
source "$ZSH/oh-my-zsh.sh"

# Autosuggestions + syntax highlighting, sourced directly (robust across packaging)
for _f in \
  "${ZDOTDIR}/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  "${ZDOTDIR}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
  [[ -r "$_f" ]] && source "$_f"
done
unset _f

autoload -Uz add-zsh-hook

# --- direnv ----------------------------------------------------------------
# Hook direnv here so that `cd`-ing between folders loads/unloads the matching
# environment -- crucially, leaving a project's local ./.venv reverts to the
# shared nix-uv env instead of the venv "sticking". VS Code integrated terminals
# point ZDOTDIR at this dir, so the user's ~/.zshrc -- which normally hooks
# direnv -- is NOT read; without this hook, direnv never sees a `cd`. Guard so we
# do NOT double-hook in terminals that already loaded it via ~/.zshrc (kitty,
# plain ssh). direnv bootstraps the flake env, so it is normally already on PATH;
# if a cold start hasn't put it there yet, retry on each prompt until it appears.
_rsm_direnv_hook_init() {
  if (( ${+functions[_direnv_hook]} )); then          # already hooked (e.g. ~/.zshrc)
    add-zsh-hook -d precmd _rsm_direnv_hook_init 2>/dev/null; return 0
  fi
  command -v direnv >/dev/null 2>&1 || return 1        # not on PATH yet; retry next prompt
  eval "$(direnv hook zsh)"
  _direnv_hook 2>/dev/null                              # load the current dir's env now
  add-zsh-hook -d precmd _rsm_direnv_hook_init 2>/dev/null
}
_rsm_direnv_hook_init || add-zsh-hook precmd _rsm_direnv_hook_init

# --- aliases ---------------------------------------------------------------
alias c="clear"
# The GitHub setup command is `rsm-github`. oh-my-zsh's web-search plugin and
# GitHub Desktop both define a browser-opening `github` alias that would shadow
# it (aliases beat PATH), so point the old name at the real command here -- this
# runs after oh-my-zsh, so it wins.
alias github='rsm-github'
alias sbase='source "$RSM_UV_ENV/bin/activate"'   # (re)activate the nix-uv env
alias sp='source .venv/bin/activate'              # activate a project .venv
alias de=deactivate
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
# --- Nix-env shell extras: eza-backed ls + zoxide (`z`) --------------------
# eza and zoxide come from the Nix env, which direnv loads AFTER this .zshrc is
# sourced, and UNLOADS when you cd out of the workspace. So `ls`/`lsa`/`lt` are
# FUNCTIONS that check for eza at CALL time and fall back to the system `ls` --
# they never break, whether the env hasn't loaded yet or eza has left PATH (an
# alias fixed to eza would instead fail "command not found: eza" once eza is gone).
#
# CRITICAL: oh-my-zsh already set `alias ls='ls --color=tty'` above. With that
# alias live, `ls() { ... }` alias-EXPANDS to `ls --color=tty () { ... }` and
# fails to PARSE -- which aborts the REST of this file (p10k, etc.). So unalias
# ls/lsa/lt FIRST (must be its own command so it runs before the next line is
# parsed), then define the functions. (`zsh -n` can't catch this: it never runs
# the earlier `source oh-my-zsh.sh`, so the alias isn't set at parse time.)
# >>> rsm-ls-functions >>>  (extracted + tested by tests/check-shell-ls.zsh)
unalias ls lsa lt 2>/dev/null || true
ls()  { if command -v eza >/dev/null 2>&1; then eza -lh  --group-directories-first --icons=auto "$@"; else command ls "$@"; fi; }
lsa() { if command -v eza >/dev/null 2>&1; then eza -lah --group-directories-first --icons=auto "$@"; else command ls -la "$@"; fi; }
lt()  { if command -v eza >/dev/null 2>&1; then eza --tree --level=2 --git --icons=auto "$@"; else command ls "$@"; fi; }
# <<< rsm-ls-functions <<<

# zoxide (`z`) also comes from the Nix env; initialize it once it is on PATH
# (retry each prompt until then). After you cd OUT of the workspace zoxide leaves
# PATH but its chpwd hook stays registered and would print "__zoxide_hook:
# command not found" on every cd, so wrap it to quietly no-op.
_rsm_zoxide_init() {
  command -v zoxide >/dev/null 2>&1 || return 1   # env not loaded yet; retry next prompt
  eval "$(zoxide init zsh)"
  if (( $+functions[__zoxide_hook] )); then
    functions[__rsm_zoxide_hook_orig]=$functions[__zoxide_hook]
    __zoxide_hook() { command -v zoxide >/dev/null 2>&1 && __rsm_zoxide_hook_orig "$@"; }
  fi
  add-zsh-hook -d precmd _rsm_zoxide_init 2>/dev/null
}
_rsm_zoxide_init || add-zsh-hook precmd _rsm_zoxide_init

# Powerlevel10k prompt configuration.
[[ ! -f "${ZDOTDIR}/.p10k.zsh" ]] || source "${ZDOTDIR}/.p10k.zsh"

# --- adaptive venv label + right-prompt fitting ----------------------------
# The virtualenv indicator lives in p10k's RIGHT prompt, and zsh hides the WHOLE
# right prompt when the left and right halves do not fit -- it never truncates a
# segment. So on a narrow terminal (a VS Code panel) the indicator did not get
# shorter, it vanished, and the shell looked like no environment was active.
#
# Both adjustments run in precmd, where $COLUMNS is still the real terminal
# width. They cannot be done from a prompt expansion: p10k sets COLUMNS=1024
# while EXPANDING the prompt and keeps the real width in an internal variable.
#
#   1. Shrink the venv label to what the line can afford, so more of the name
#      appears as the terminal gets wider (or the font smaller).
#   2. Hide context/time/nix_shell when the line is tight, so the venv label is
#      what survives. Nothing is lost by this: at those widths the ENTIRE right
#      prompt was hidden before, so none of those segments were visible anyway.
#
# RSM_VENV_LABEL (exported by a managed .envrc) is the full label; without it we
# fall back to the venv's own directory name, so foreign venvs still work.
_rsm_venv_label() {
  [[ -n ${RSM_VENV_LABEL:-} ]] && { print -r -- "$RSM_VENV_LABEL"; return 0 }
  [[ -n ${VIRTUAL_ENV:-} ]] || return 1
  [[ $VIRTUAL_ENV == ${RSM_UV_ENV:-/nonexistent} ]] && { print -r -- nix-uv; return 0 }
  local base=${VIRTUAL_ENV:t}
  [[ $base == (venv|.venv|env|virtualenv) ]] && base=${VIRTUAL_ENV:h:t}
  print -r -- "$base"
}

_rsm_prompt_fit() {
  (( $+functions[p10k] )) || return 0
  local full; full="$(_rsm_venv_label)" || full=""

  # What the rest of the line costs. The directory segment dominates and varies
  # with depth, so derive it from %~ rather than hardcoding a constant. p10k
  # truncates the path on narrow terminals, so %~ OVER-estimates there -- which
  # errs toward a shorter label. That is the safe direction: over-estimating the
  # available width makes the right prompt overflow and disappear entirely,
  # which is exactly the failure this hook exists to prevent.
  local cost=${RSM_PROMPT_COST:-$(( 24 + ${#${(%):-%~}} ))}

  # context + time + nix_shell cost roughly 45 columns between them; show them
  # only when they fit alongside the whole label.
  local mode=narrow
  (( COLUMNS >= cost + ${#full} + 45 )) && mode=wide
  if [[ $mode != ${_rsm_prompt_mode:-} ]]; then
    typeset -g _rsm_prompt_mode=$mode
    if [[ $mode == narrow ]]; then
      p10k display '*/context'=hide '*/time'=hide '*/nix_shell'=hide 2>/dev/null
    else
      p10k display '*/context'=show '*/time'=show '*/nix_shell'=show 2>/dev/null
    fi
  fi

  [[ -n $full ]] || return 0
  local budget=$(( COLUMNS - cost ))
  (( budget < 3 )) && budget=3
  local label=$full
  (( ${#full} > budget )) && label="${full[1,budget-1]}…"
  [[ ${VIRTUAL_ENV_PROMPT:-} == "($label) " ]] || export VIRTUAL_ENV_PROMPT="($label) "
}
add-zsh-hook precmd _rsm_prompt_fit

# --- personal, opt-in overrides -------------------------------------------
# Sourced last so it can override anything above (e.g. `bindkey -v` for vi mode,
# or `set -o vi`). Lives in $HOME so it survives a workspace reset; students
# never get it unless they deliberately create the file.
[[ -f "$HOME/.rsm-local.zsh" ]] && source "$HOME/.rsm-local.zsh"
