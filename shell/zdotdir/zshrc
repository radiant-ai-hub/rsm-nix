# RSM-MSBA environment .zshrc — the full oh-my-zsh + powerlevel10k shell for the
# rsm-msba environment. Loaded two ways: at startup when ZDOTDIR points here (VS
# Code terminals), and mid-session by the system zsh chpwd hook when you cd into
# ~/rsm-msba (kitty and other terminals). Installed/refreshed by `rsm-setup`;
# edit the source in the flake (shell/zdotdir/zshrc), not this copy.

# Guard against double-sourcing (the chpwd hook plus a ZDOTDIR startup read can
# both fire). p10k instant prompt is disabled in .p10k.zsh, so there is no
# instant-prompt cache to source here and mid-session loading stays clean.
[[ -n ${_RSM_ZSHRC_DONE:-} ]] && return 0
typeset -g _RSM_ZSHRC_DONE=1

export ZSH="${ZDOTDIR}/.oh-my-zsh"
export ZSH_CACHE_DIR="${ZDOTDIR}/.cache"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump"
ZSH_DISABLE_COMPFIX="true"
DISABLE_AUTO_UPDATE="true"          # oh-my-zsh is provided by Nix; don't self-update

ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)                        # git via oh-my-zsh's own plugin format
source "$ZSH/oh-my-zsh.sh"

# Autosuggestions + syntax highlighting, sourced directly (robust across packaging)
for _f in \
  "${ZDOTDIR}/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  "${ZDOTDIR}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
  [[ -r "$_f" ]] && source "$_f"
done
unset _f

autoload -Uz add-zsh-hook

# --- aliases ---------------------------------------------------------------
alias c="clear"
alias sbase='source "$RSM_UV_ENV/bin/activate"'   # (re)activate the nix-uv env
alias sp='source .venv/bin/activate'              # activate a project .venv
alias de=deactivate
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
if command -v eza >/dev/null 2>&1; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='eza -lah --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --git --icons=auto'
fi

# --- zoxide (`z <name>` to jump to folders) -------------------------------
# Init now if zoxide is on PATH; otherwise on the first prompt (once direnv has
# loaded the environment that provides zoxide).
_rsm_zoxide_init() {
  command -v zoxide >/dev/null 2>&1 || return 1
  eval "$(zoxide init zsh)"
  # zoxide is provided by the Nix env (direnv). When you cd OUT of the workspace
  # direnv unloads it and zoxide leaves PATH, but zoxide's chpwd hook stays
  # registered and would print "__zoxide_hook: command not found" on every cd
  # (seen in a plain terminal; VS Code's direnv keeps the env loaded so it does
  # not). Wrap the hook so it quietly no-ops when zoxide isn't on PATH.
  if (( $+functions[__zoxide_hook] )); then
    functions[__rsm_zoxide_hook_orig]=$functions[__zoxide_hook]
    __zoxide_hook() { command -v zoxide >/dev/null 2>&1 && __rsm_zoxide_hook_orig "$@"; }
  fi
  add-zsh-hook -d precmd _rsm_zoxide_init 2>/dev/null
}
_rsm_zoxide_init || add-zsh-hook precmd _rsm_zoxide_init

# Powerlevel10k prompt configuration.
[[ ! -f "${ZDOTDIR}/.p10k.zsh" ]] || source "${ZDOTDIR}/.p10k.zsh"

# --- personal, opt-in overrides -------------------------------------------
# Sourced last so it can override anything above (e.g. `bindkey -v` for vi mode,
# or `set -o vi`). Lives in $HOME so it survives a workspace reset; students
# never get it unless they deliberately create the file.
[[ -f "$HOME/.rsm-local.zsh" ]] && source "$HOME/.rsm-local.zsh"
